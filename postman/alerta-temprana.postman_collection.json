          "raw": "{\n  \"lecturaId\": 1,\n  \"tipo\": \"UMBRAL\",\n  \"nivel\": \"CRITICO\",\n  \"mensaje\": \"Humedad sobre el umbral critico\"\n}",
          "options": {
