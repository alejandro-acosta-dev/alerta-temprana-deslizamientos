              "pm.test(\"El error es UNAUTHORIZED\", () => pm.expect(pm.response.json().estado).to.eql(\"UNAUTHORIZED\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
