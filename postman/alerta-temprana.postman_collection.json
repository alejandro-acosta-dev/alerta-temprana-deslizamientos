    {
      "name": "04 Crear alerta como administrador (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
              "const alerta = pm.response.json();",
              "pm.test(\"Devuelve la alerta creada\", () => {",
              "  pm.expect(alerta.id).to.be.a(\"number\");",
              "  pm.expect(alerta.tipo).to.eql(\"UMBRAL\");",
              "  pm.expect(alerta.nivel).to.eql(\"CRITICO\");",
              "});",
              "pm.test(\"La cabecera Location apunta a la nueva alerta\", () => {",
              "  pm.expect(pm.response.headers.get(\"Location\")).to.include(\"/api/alertas/\" + alerta.id);",
              "});",
              "pm.collectionVariables.set(\"alertaId\", alerta.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
