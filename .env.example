# Variables de entorno del proyecto. Copie este archivo como .env y complete los valores.
# El archivo .env NO se sube a Git (está en .gitignore). Aquí solo van los nombres y valores de ejemplo.
# Lista completa y explicación en la Vista de Despliegue (docs/DAS.pdf, sección 3.5).

# Base de datos PostgreSQL (la API y docker-compose.yml las usan desde ya)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=alerta_deslizamientos
DB_USER=alerta_app
DB_PASSWORD=cambiar_esta_clave

# Servidor de la API
SERVER_PORT=8080

# Seguridad
# JWT_SECRET firma los tokens del login: la API NO arranca sin ella y exige al menos
# 32 caracteres. Cambie el valor de ejemplo por uno propio, largo y aleatorio.
JWT_SECRET=cambiar_por_un_valor_largo_y_aleatorio
# Minutos que dura un token (opcional; si se omite, 60).
JWT_EXPIRACION_MINUTOS=60
# Se usa cuando se implemente el webhook de SMS (todavia no).
WEBHOOK_SECRET=cambiar_por_un_valor_largo_y_aleatorio

# Correo (SMTP): se usan cuando se implemente el canal de correo
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Telegram: se usan cuando se implemente el canal de Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
